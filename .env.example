# rss-reader configuration — copy to .env and adjust as needed.
# All variables are optional; defaults are shown below.

# SQLite database location
RSS_READER_DB=~/.rss-reader/rss_reader.db

# Port the web app (`rss-reader serve`) listens on
RSS_READER_PORT=8000

# Address to bind. Loopback by default, because identity arrives in the
# Tailscale-User-Login header and that is only trustworthy while the ingress is
# the only route to this port. Set 0.0.0.0 only when something else closes the
# door: inside a container whose port is published on 127.0.0.1, for instance.
RSS_READER_HOST=127.0.0.1

# Comma-separated Tailscale logins allowed to use this reader. No default, and
# an empty value stops the app rather than starting it open. A login not on the
# list gets a 403; one on it gets an account the first time it appears.
RSS_READER_HOUSEHOLD=you@example.com,someone@example.com

# Login the CLI acts as when --user is not given. See: rss-reader user list
RSS_READER_CLI_USER=you@example.com

# Background auto-refresh (0 to disable)
RSS_READER_AUTO_REFRESH=1

# Auto-refresh interval, seconds
RSS_READER_REFRESH_INTERVAL=900

# Max feeds fetched in parallel per refresh
RSS_READER_CONCURRENCY=8

# Auto-prune read items older than N days (0 = keep all)
RSS_READER_RETENTION_DAYS=0

# Per-feed fetch timeout, seconds
RSS_READER_TIMEOUT=15

# Refuse to fetch URLs that resolve to loopback, private or link-local
# addresses. Adding a feed makes the server fetch a URL somebody else chose, so
# turning this off on a machine running anything else hands every user a way to
# reach it. Off only for offline tests.
RSS_READER_FETCH_GUARD=1

# Redirect hops followed, and the ceiling on one fetched body in bytes.
RSS_READER_MAX_REDIRECTS=5
RSS_READER_MAX_BYTES=5242880

# Seconds a connection waits for a SQLite lock before giving up.
RSS_READER_BUSY_TIMEOUT=10
